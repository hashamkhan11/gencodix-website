# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for canonical links, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://gencodix.com

# Optional: Calendly / Cal.com link shown on the contact page
NEXT_PUBLIC_BOOKING_URL=

# AI project scoper (/start) — https://platform.claude.com
ANTHROPIC_API_KEY=

# Lead emails from the contact form and scoper — https://resend.com
RESEND_API_KEY=
LEAD_TO_EMAIL=contact@gencodix.com
# Must be on a domain verified in Resend
LEAD_FROM_EMAIL=Gencodix Website <leads@gencodix.com>
